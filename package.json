{
  "name": "disputatio",
  "version": "0.7.2",
  "description": "Structured debate between real AI coding-agent CLIs (Kaizen MVP v0)",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcomd/disputatio.git"
  },
  "homepage": "https://github.com/marcomd/disputatio#readme",
  "bugs": {
    "url": "https://github.com/marcomd/disputatio/issues"
  },
  "bin": {
    "disputatio": "dist/index.js"
  },
  "files": [
    "dist",
    "examples/debate.yaml",
    "examples/task.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "debate": "node src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js",
    "prepack": "npm run build && node scripts/use-npm-readme.mjs",
    "postpack": "node scripts/restore-repo-readme.mjs",
    "restore-readme": "node scripts/restore-repo-readme.mjs",
    "test": "node --test \"test/*.test.ts\""
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}