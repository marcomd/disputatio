#!/bin/sh
# Fake GitHub Copilot CLI for tests: behavior driven by FAKE_* env vars.
[ -n "$FAKE_SLEEP" ] && sleep "$FAKE_SLEEP"
if [ -n "$FAKE_HANG" ]; then
  sleep 8 &
  trap '' TERM
  sleep 8
  exit 0
fi
# FAKE_KILL_SELF: die by SIGNAL after writing noise to stderr — the case where a
# stderr-first error string would swallow the signal entirely.
if [ -n "$FAKE_KILL_SELF" ]; then
  [ -n "$FAKE_STDERR" ] && echo "$FAKE_STDERR" >&2
  kill -"$FAKE_KILL_SELF" $$
  sleep 5   # unreachable if the signal lands; bounds the test if it does not
fi
[ -n "$FAKE_ARGV_FILE" ] && printf '%s\n' "$@" > "$FAKE_ARGV_FILE"
[ -n "$FAKE_STDOUT_FILE" ] && cat "$FAKE_STDOUT_FILE"
[ -n "$FAKE_STDERR" ] && echo "$FAKE_STDERR" >&2
exit "${FAKE_EXIT:-0}"
